{
  "opencollection": "1.0.0",
  "info": {
    "name": "Softr Databases API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Softr-Api-Key",
      "value": "{{Softr-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Databases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List databases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://studio-api.softr.io/v1/api/databases"
          },
          "docs": "Lists the Softr Databases accessible to the API token."
        }
      ]
    }
  ],
  "bundled": true
}